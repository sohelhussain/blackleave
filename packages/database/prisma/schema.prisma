datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  image         String?
  googleSubject String?       @unique
  googleId      String?       @unique
  passwordHash  String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]
  profile       Profile?
  sessions      Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Profile {
  id                    String                   @id @default(uuid())
  userId                String                   @unique
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileCompleted      Boolean                  @default(false)
  fullName              String
  firstName             String
  lastName              String
  preferredName         String?
  email                 String
  phone                 String
  city                  String
  state                 String
  country               String
  pincode               String
  address               String?
  postalCode            String?
  age                   Int?
  dateOfBirth           String?
  gender                String?
  genderCustom          String?
  linkedin              String?
  github                String?
  portfolio             String?
  summary               String?
  tenthPercentage       String?
  twelfthPercentage     String?
  twelfthStream         String?
  employmentStatus      String?
  isStudent             Boolean                  @default(false)
  studentEnrollment     StudentEnrollment?
  targetIndustries      String[]                 @default([])
  targetJobTitles       String[]                 @default([])
  targetCareerAreas     String[]                 @default([])
  jobPreference         JobPreference?
  workAuthorization     WorkAuthorization?
  countryAuthorizations CountryAuthorization[]
  applicationQuestions  ProfileQuestionAnswer[]
  coverLetters          CoverLetter[]
  education             Education[]
  experience            Experience[]
  projects              Project[]
  skills                Skill[]
  resumes               Resume[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model JobPreference {
  id                    String   @id @default(uuid())
  profileId             String   @unique
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetRoles           String[]
  employmentTypes       String[]
  preferredLocations    String[]
  willingToRelocate     Boolean  @default(true)
  willingToWorkRemotely Boolean  @default(true)
  noticePeriod          String
  expectedSalaryMin     Int?
  expectedSalaryMax     Int?
  salaryCurrency        String   @default("INR")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WorkAuthorization {
  id                        String   @id @default(uuid())
  profileId                 String   @unique
  profile                   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  indiaAuthorized           Boolean  @default(true)
  indiaSponsorshipRequired  Boolean  @default(false)
  usAuthorized              Boolean  @default(true)
  usSponsorshipRequired     Boolean  @default(true)
  europeAuthorized          Boolean  @default(true)
  europeSponsorshipRequired Boolean  @default(true)
  otherDetails              String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model StudentEnrollment {
  id                      String   @id @default(uuid())
  profileId               String   @unique
  profile                 Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  isCurrentlyEnrolled     Boolean  @default(true)
  institution             String
  degreeProgram           String
  fieldOfStudy            String
  currentYearSemester     String
  expectedGraduationDate  String
  openToStudyCombinedJobs Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CountryAuthorization {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  countryCode String
  countryName String
  status      String   // AUTHORIZED, REQUIRES_SPONSORSHIP, NOT_AUTHORIZED, UNSURE
  visaType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, countryCode])
}

model ProfileQuestionAnswer {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String   // MOTIVATION, CAREER, AVAILABILITY, etc.
  question  String
  answer    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoverLetter {
  id            String   @id @default(uuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  content       String
  isDefault     Boolean  @default(false)
  targetRole    String?
  targetCompany String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Education {
  id                 String   @id @default(uuid())
  profileId          String
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degree             String
  branch             String
  university         String
  location           String
  startDate          String
  endDate            String?
  expectedGraduation String?
  cgpa               String?
  percentage         String?
  stream             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Experience {
  id               String   @id @default(uuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company          String
  title            String
  employmentType   String
  location         String
  workMode         String
  startDate        String
  endDate          String?
  current          Boolean  @default(false)
  responsibilities String[]
  technologies     String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id                 String   @id @default(uuid())
  profileId          String
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title              String
  description        String
  technologies       String[]
  features           String[]
  securityHighlights String[]
  url                String?
  githubUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Skill {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id             String        @id @default(uuid())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  fileName       String
  fileData       String?
  fileType       String?
  targetRoles    String[]
  relevantSkills String[]
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
}

model Application {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  role           String
  url            String
  date           String
  resumeUsedId   String?
  resumeUsed     Resume?            @relation(fields: [resumeUsedId], references: [id])
  fieldsFilled   Int                @default(0)
  aiAnswersCount Int                @default(0)
  status         String             @default("Draft")
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  fields         ApplicationField[]
  aiAnswers      AIAnswer[]
}

model ApplicationField {
  id                    String      @id @default(uuid())
  applicationId         String
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  detectedLabel         String
  fieldType             String
  suggestedProfileField String?
  confidence            Float
  source                String
  suggestedValue        String?
  userValue             String?
  approved              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model AIAnswer {
  id             String       @id @default(uuid())
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question       String
  classification String
  confidence     Float
  answer         String
  reason         String?
  sourceIds      String[]
  createdAt      DateTime     @default(now())
}
