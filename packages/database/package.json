{
  "name": "@applyflow/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:setup": "prisma db push && node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@applyflow/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
